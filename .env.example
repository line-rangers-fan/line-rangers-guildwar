PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/guildwar.sqlite
# Optional guild rankings. The application also works using local guilds.
GUILD_SOURCE_URL=https://rangers.lerico.net/api/v2/guilds
# Optional independent fallback; no fallback is used by default.
GUILD_FALLBACK_URL=
# Optional independent member provider, with the literal {gid} placeholder.
# Accepts {"members":[{"uid":"stable-id","userName":"name","level":1,"pvpLeaguePhase":""}]}.
# No member network request is made when empty. Manual rosters take precedence.
MEMBER_SOURCE_URL=
# Optional key for all write operations. Enter it in the settings panel.
WRITE_TOKEN=
